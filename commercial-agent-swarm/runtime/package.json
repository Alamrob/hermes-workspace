{
  "name": "@proptimiza/commercial-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:broker": "node dist/broker-main.js",
    "start:executor": "node dist/executor-main.js",
    "start:crm-sync": "node dist/crm-sync-main.js",
    "start:commercial-automation": "node dist/commercial-automation-main.js",
    "start:external-action-broker": "node dist/external-action-broker-main.js",
    "start:telegram-approval-poller": "node dist/telegram-approval-poller-main.js",
    "start:workspace-instruction-gateway": "node dist/workspace-instruction-gateway-main.js",
    "smoke:usage": "node dist/usage-smoke-main.js",
    "reconcile:crm-sync": "node dist/crm-sync-main.js reconcile",
    "migrate": "node dist/migrate-main.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:unit": "tsx --test test/**/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 integration/**/*.test.ts",
    "test:postgres:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-postgres-17.ps1",
    "test:linux-identity": "node scripts/test-linux-runtime-identity.mjs",
    "test:linux-service-secrets": "node scripts/test-linux-service-secrets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.16.3",
    "undici": "8.10.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.15.5",
    "tsx": "4.21.0",
    "typescript": "5.7.2"
  }
}
