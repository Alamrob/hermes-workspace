{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proptimiza.local/contracts/supervised-review-scope.schema.json",
  "title": "Proptimiza supervised Chatwoot review scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_id",
    "account_id",
    "inbox_id",
    "conversations",
    "authorized_fact_ids",
    "commercial_fact_catalog_sha256",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "proptimiza-supervised-review-scope.v3"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "inbox_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversation_id", "public_entry_context"],
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "public_entry_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "surface", "acquisition"],
            "properties": {
              "channel": { "const": "whatsapp" },
              "surface": {
                "enum": ["unknown", "proptimiza_main", "conversa", "launch", "forge", "automatiza"]
              },
              "acquisition": {
                "enum": ["unknown", "direct", "organic", "google_ads", "meta_ads", "referral"]
              }
            }
          }
        }
      }
    },
    "authorized_fact_ids": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "commercial_fact_catalog_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "authorized_fact_ids": { "maxItems": 0 } }
      },
      "then": {
        "properties": { "commercial_fact_catalog_sha256": { "type": "null" } }
      },
      "else": {
        "properties": { "commercial_fact_catalog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    }
  ]
}
