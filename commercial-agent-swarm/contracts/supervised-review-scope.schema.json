{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proptimiza.local/contracts/supervised-review-scope.schema.json",
  "title": "Proptimiza supervised Chatwoot review scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_id",
    "account_id",
    "inbox_id",
    "conversation_ids",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "proptimiza-supervised-review-scope.v1"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "inbox_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "conversation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,17}$"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
