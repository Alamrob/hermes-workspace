{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proptimiza.local/schemas/commercial-swarm/assignment.schema.json",
  "title": "Hermes Commercial Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "trace_id",
    "assignment_id",
    "agent_id",
    "objective",
    "depends_on",
    "allowed_actions",
    "prohibited_actions",
    "approved_tools",
    "autonomy_ceiling",
    "input_artifacts",
    "expected_output",
    "required_evidence",
    "budget_allocation",
    "deadline",
    "idempotency_key",
    "checkpoint_contract"
  ],
  "properties": {
    "mission_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "assignment_id": { "type": "string", "format": "uuid" },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "objective": { "type": "string", "minLength": 1 },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "approved_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "autonomy_ceiling": { "enum": ["A0", "A1", "A2", "A3"] },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "version", "content_hash", "uri"],
        "properties": {
          "artifact_id": { "type": "string" },
          "version": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "uri": { "type": "string" }
        }
      }
    },
    "expected_output": { "type": "string", "minLength": 1 },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "budget_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "maximum"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "deadline": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 8 },
    "checkpoint_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "schema_id", "stop_after_checkpoint"],
      "properties": {
        "statuses": {
          "type": "array",
          "const": [
            "completed",
            "partial",
            "blocked",
            "failed",
            "approval_required"
          ]
        },
        "schema_id": {
          "const": "https://proptimiza.local/schemas/commercial-swarm/agent-result.schema.json"
        },
        "stop_after_checkpoint": { "const": true }
      }
    }
  }
}
