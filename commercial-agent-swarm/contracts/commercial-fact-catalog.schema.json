{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proptimiza.local/contracts/commercial-fact-catalog.schema.json",
  "title": "Proptimiza commercial fact authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "catalog_id", "generated_at", "expires_at", "facts"],
  "properties": {
    "schema": { "const": "proptimiza-commercial-fact-catalog.v1" },
    "status": { "const": "active" },
    "catalog_id": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "statement", "source_ref", "approved_by_role", "approved_at", "expires_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "category": { "enum": ["identity", "offer", "capability", "integration", "policy", "hours", "pricing", "result"] },
          "statement": { "type": "string", "minLength": 1, "maxLength": 400 },
          "source_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$" },
          "approved_by_role": { "enum": ["commercial_owner", "operations", "security", "legal"] },
          "approved_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
