{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alam.cl/contracts/crm-summary.schema.json",
  "title": "Twenty CRM Summary v1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["status", "connector", "outbox", "inboxCount", "entityLinkCount", "cursorCount", "lastSuccessfulSyncAt", "provenance"],
      "properties": {
        "status": { "const": "known" },
        "connector": { "const": "twenty" },
        "outbox": {
          "type": "object", "additionalProperties": false,
          "required": ["pending", "leased", "confirmed", "failed", "outcomeUnknown"],
          "properties": {
            "pending": { "$ref": "#/$defs/count" },
            "leased": { "$ref": "#/$defs/count" },
            "confirmed": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "outcomeUnknown": { "$ref": "#/$defs/count" }
          }
        },
        "inboxCount": { "$ref": "#/$defs/count" },
        "entityLinkCount": { "$ref": "#/$defs/count" },
        "cursorCount": { "$ref": "#/$defs/count" },
        "lastSuccessfulSyncAt": { "type": ["string", "null"], "format": "date-time" },
        "provenance": { "const": "postgres" }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["status", "connector", "outbox", "inboxCount", "entityLinkCount", "cursorCount", "lastSuccessfulSyncAt", "provenance"],
      "properties": {
        "status": { "const": "disabled" },
        "connector": { "const": "twenty" },
        "outbox": { "type": "null" },
        "inboxCount": { "type": "null" },
        "entityLinkCount": { "type": "null" },
        "cursorCount": { "type": "null" },
        "lastSuccessfulSyncAt": { "type": "null" },
        "provenance": { "const": "simulation-disabled" }
      }
    }
  ],
  "$defs": { "count": { "type": "integer", "minimum": 0 } }
}
