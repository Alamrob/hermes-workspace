{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alam.cl/contracts/crm-summary.schema.json",
  "title": "Twenty CRM Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["availability", "accounts", "contacts", "opportunities", "pipelineUsd", "provenance"],
  "properties": {
    "availability": { "enum": ["available", "unavailable"] },
    "accounts": { "type": ["integer", "null"], "minimum": 0 },
    "contacts": { "type": ["integer", "null"], "minimum": 0 },
    "opportunities": { "type": ["integer", "null"], "minimum": 0 },
    "pipelineUsd": { "type": ["number", "null"], "minimum": 0 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceId", "observedAt", "synthetic"],
      "properties": {
        "source": { "const": "twenty" },
        "sourceId": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "synthetic": { "const": false }
      }
    },
    "message": { "type": "string" }
  }
}
